{
  "version": 2,
  "buildCommand": "cd FE-Social-Media && pnpm run build && cd .. && node -e \"require('fs').cpSync('FE-Social-Media/dist', 'dist', {recursive: true})\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(auth|posts|chat|events|admin|bookmark|graphql|users|socket.io|nlp|notification|notifications|file)(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
